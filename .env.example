# ==============================================================================
# LearnFromClip (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Turnstile Bot Protection
# ------------------------------------------------------------------------------
# Frontend Website Site Key (Public)
# Add this in Cloudflare Pages -> Settings -> Environment Variables, or your local .env
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Backend Server Secret Key (Private)
# Add this via `npx wrangler secret put TURNSTILE_SECRET_KEY` or Cloudflare Workers dashboard
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 2. Lemon Squeezy (Merchant of Record & Payments)
# ------------------------------------------------------------------------------
# Used to verify incoming webhook signatures in src/server/utils/paymentsAndAuth.ts
LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret_here

# Optional Lemon Squeezy API key for customer portal / checkout generation
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here

# ------------------------------------------------------------------------------
# 3. Authentication & Sessions (Passwordless Magic Links)
# ------------------------------------------------------------------------------
# Secret key used to sign email magic links and session tokens
MAGIC_LINK_SECRET=your_secure_random_string_here

# ------------------------------------------------------------------------------
# 4. Cloudflare D1 & R2 Bindings (configured in wrangler.toml or Cloudflare dashboard)
# ------------------------------------------------------------------------------
# D1 Database: DB (e.g. textfromclip-db / learnfromclip-db)
# Workers AI: AI
# R2 Bucket: UPLOADS_BUCKET (e.g. textfromclip-uploads)
