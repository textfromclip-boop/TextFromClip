# ==============================================================================
# LearnFromClip — configuration reference (names match the code exactly)
# Secrets: `npx wrangler secret put NAME` (Worker) or
#          `npx wrangler pages secret put NAME --project-name textfromclip` (Pages)
# Local dev: put these in .dev.vars (never commit it)
# ==============================================================================

# --- Required in production ---------------------------------------------------
COOKIE_SECRET=generate-with-openssl-rand-base64-48   # >= 32 chars; API returns 503 without it
ADMIN_TOKEN=generate-a-long-random-token            # >= 24 chars; admin console password + Bearer token for /api/admin/costs

# --- Private admin console -------------------------------------------------------
# The console lives at https://<your-site>/<ADMIN_PATH>. Keep it secret (16-64 letters, digits, - or _).
# Without it the console does not exist. Sign in with ADMIN_TOKEN.
ADMIN_PATH=generate-a-random-path-like-ops-k3v9x2m7q4w8

# --- Site-wide daily AI budget (USD) ---------------------------------------------
# New AI work pauses until 00:00 UTC once today's estimated AI spend reaches this. Default 0.09,
# which stays inside Cloudflare's free 10,000 neurons/day (= $0.11), so the AI bill is $0.
# AI_DAILY_BUDGET_USD=0.09

# --- Google OAuth 2.0 ("Continue with Google" sign-in) -------------------------
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Optional: Email (fallback magic-link sign-in) -----------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="LearnFromClip <login@learnfromclip.com>"   # domain must be verified in Resend
APP_BASE_URL=https://learnfromclip.com                 # optional; used in OAuth & emailed links

# --- Cloudflare Turnstile -----------------------------------------------------
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx      # BUILD-time variable (public)
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Lemon Squeezy (Merchant of Record) ----------------------------------------
LEMONSQUEEZY_API_KEY=your_api_key                    # test-mode key first
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_EXAM_PASS=111111                # $4.99 one-time (7 days)
LEMONSQUEEZY_VARIANT_EXAM_PASS_REGIONAL=111112       # $2.49 one-time
LEMONSQUEEZY_VARIANT_MONTHLY=222221                  # $11.99 / month subscription
LEMONSQUEEZY_VARIANT_MONTHLY_REGIONAL=222222         # $5.99 / month subscription
LEMONSQUEEZY_VARIANT_PREP_PASS=333331                # $29 one-time (3 months)
LEMONSQUEEZY_VARIANT_PREP_PASS_REGIONAL=333332       # $14.50 one-time

# --- Optional: shared per-IP daily ceiling for anonymous users --------------------
# IP_DAILY_AI_ACTIONS=30
# IP_DAILY_LINKS=50
# IP_DAILY_UPLOAD_MINUTES=200
# IP_DAILY_QUIZZES=10

# --- Bindings (wrangler.toml / dashboard, not env vars) -------------------------
# DB (D1), AI (Workers AI), UPLOADS_BUCKET (R2), ASSETS (Worker static assets)
