# ==============================================================================
# LearnFromClip — configuration reference (names match the code exactly)
# Secrets: `npx wrangler secret put NAME` (Worker) or
#          `npx wrangler pages secret put NAME --project-name textfromclip` (Pages)
# Local dev: put these in .dev.vars (never commit it)
# ==============================================================================

# --- Required in production ---------------------------------------------------
COOKIE_SECRET=generate-with-openssl-rand-base64-48   # >= 32 chars; API returns 503 without it
ADMIN_TOKEN=generate-a-long-random-token            # >= 24 chars; Bearer token for /api/admin/costs

# --- Email (magic-link sign-in) -------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="LearnFromClip <login@learnfromclip.com>"   # domain must be verified in Resend
APP_BASE_URL=https://learnfromclip.com                 # optional; used in emailed links

# --- Cloudflare Turnstile -----------------------------------------------------
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx      # BUILD-time variable (public)
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Lemon Squeezy (Merchant of Record) ----------------------------------------
LEMONSQUEEZY_API_KEY=your_api_key                    # test-mode key first
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_EXAM_PASS=111111                # $2.99 one-time
LEMONSQUEEZY_VARIANT_EXAM_PASS_REGIONAL=111112       # $1.49 one-time
LEMONSQUEEZY_VARIANT_MONTHLY=222221                  # $4.99 / month subscription
LEMONSQUEEZY_VARIANT_MONTHLY_REGIONAL=222222         # $2.49 / month subscription
LEMONSQUEEZY_VARIANT_SEMESTER_PASS=333331            # $14.99 one-time
LEMONSQUEEZY_VARIANT_SEMESTER_PASS_REGIONAL=333332   # $7.49 one-time

# --- Optional: shared per-IP daily ceiling for anonymous users --------------------
# IP_DAILY_AI_ACTIONS=30
# IP_DAILY_LINKS=50
# IP_DAILY_UPLOAD_MINUTES=200
# IP_DAILY_QUIZZES=10

# --- Bindings (wrangler.toml / dashboard, not env vars) -------------------------
# DB (D1), AI (Workers AI), UPLOADS_BUCKET (R2), ASSETS (Worker static assets)
